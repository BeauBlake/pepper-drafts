      {
       "id": "0cc1a6da",
       "elType": "widget",
       "widgetType": "text-editor",
       "settings": {
        "editor": "<p style=\"max-width:615px;\">You will love having a Pepper van on your next video shoot. Giving our clients an\n        unforgettable shoot day is what we love most — so we built production vans that keep\n        our kit in prime condition while providing coffee, cold drinks and shade wherever the\n        job takes us.</p><p style=\"max-width:615px;\">They're the perfect environment for reviewing footage and imagery on the spot, and\n        they double as a change room or a makeup area when a shoot needs one.</p><p style=\"max-width:615px;\">Between the two, there is a right vehicle for the job: one that can disappear up a\n        forestry track for two days, and one that can be parked outside a city office at 7am\n        without a second thought.</p>",
        "text_color": "#55575C",
        "typography_typography": "custom",
        "typography_font_family": "Montserrat",
        "typography_font_size": {
         "unit": "px",
         "size": 16
        },
