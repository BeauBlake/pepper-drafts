    {
     "id": "16b6233e",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p style=\"margin:0;max-width:615px;\">Stick ‘n Rudder are a team of passionate tailwheel pilots, here to bring back the best of the past, creating future aviators with superior skills.</p><p style=\"margin:0;margin-top:20px;max-width:615px;\">Stick ‘n Rudder were the lucky winners of our Ultimate Content Package! This package included quality high-end videography and photography.</p><p style=\"margin:0;margin-top:20px;max-width:615px;\">We love shooting photos and videos at great locations, but where we went with Stick ‘n Rudder was next level. At Pepper Productions, we thrive in the outdoors but coupled with an amazing shooting view, our time with Stick ‘n Rudder was one of our most memorable video projects yet!</p>",
      "text_color": "#55575C",
      "typography_typography": "custom",
      "typography_font_family": "Montserrat",
      "typography_font_size": {
       "unit": "px",
       "size": 16
