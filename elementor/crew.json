     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p style=\"max-width:615px;\">We're not just a video production company on the Sunshine Coast — we're a team of\n      passionate storytellers who capture the heart of your brand through high-end photography\n      and cinematic video. From first idea to final edit, we offer end-to-end production that's as strategic as it is\n      creative. Whether it's a corporate campaign, a branded tale, or a suite of scroll-stopping\n      visuals, our team is here to help your brand connect.</p>",
      "text_color": "#55575C",
      "typography_typography": "custom",
