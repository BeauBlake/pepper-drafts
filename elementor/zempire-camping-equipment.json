    {
     "id": "0d853e88",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p style=\"margin:0;max-width:615px;\">Zempire® is the little New Zealand camping empire built by husband-and-wife team Richard and Sophie Knauf. From small beginnings, a dedication to smart design and “the last 10%” (These are the design features that elevate a product to something you’ll want to tell your friends about.) has seen this Kiwi company quietly build a global community of devoted fans.</p><p style=\"margin:0;margin-top:20px;max-width:615px;\">And they approached us for product videography…</p><p style=\"margin:0;margin-top:20px;max-width:615px;\">We love shooting product video, and how excited were we for the opportunity to produce this for Zempire? Being outdoors is where we thrive, coupled with an amazing product to shoot, this was definitely one of our most memorable video projects.</p>",
      "text_color": "#55575C",
      "typography_typography": "custom",
      "typography_font_family": "Montserrat",
      "typography_font_size": {
       "unit": "px",
       "size": 16
      },
      "typography_line_height": {
       "unit": "px",
       "size": 26.88
      }
