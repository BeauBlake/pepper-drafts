    {
     "id": "14af9ea0",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p style=\"margin:0;max-width:615px;\">Rocky Trail Entertainment is now one of the biggest cycling events companies in Australia. Pepper was lucky enough to help Rocky Trail cover one of their recent events at the fantastic Sugerbag MTB trails in Caloundra.</p><p style=\"margin:0;margin-top:20px;max-width:615px;\">Believing in the power that stories have, we didn’t just film the great riding at the 3 races held over the weekend, but also spoke to the top riders and organisers to really capture what Rocky Trail is all about.</p>",
      "text_color": "#55575C",
      "typography_typography": "custom",
      "typography_font_family": "Montserrat",
      "typography_font_size": {
       "unit": "px",
       "size": 16
      },
      "typography_line_height": {
