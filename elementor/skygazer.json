    {
     "id": "0adea5dc",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p style=\"margin:0;max-width:615px;\">Sky Gazer has become a cult classic amongst beachgoers across the country. Pepper was lucky to work with this Sunshine Coast-based family business specialising in sand-resistant beach towels. We captured the essence of their brand and helped transform their product.</p><p style=\"margin:0;margin-top:20px;max-width:615px;\">During an initial catch-up with our crew, Sky Gazer briefed us on the concept, theme and ultimate inspo they were going for. So we got to work putting together a shot list, booking a studio to use our camera-quality lighting, sourcing models and determining on-site locations for the beach vibe they wanted.</p>",
      "text_color": "#55575C",
      "typography_typography": "custom",
      "typography_font_family": "Montserrat",
      "typography_font_size": {
       "unit": "px",
       "size": 16
      },
      "typography_line_height": {
       "unit": "px",
       "size": 26.88
      }
     },
     "elements": []
