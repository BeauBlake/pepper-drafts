    {
     "id": "167c2710",
     "elType": "widget",
     "widgetType": "text-editor",
     "settings": {
      "editor": "<p style=\"margin:0;max-width:615px;\">At Pepper Productions, we’re always up for a challenge. So when First Steps Learning Academy approached us to create a recruitment campaign, we knew it was an opportunity we couldn’t pass up.</p><p style=\"margin:0;margin-top:20px;max-width:615px;\">Based in Sydney, First Steps Learning Academy is committed to providing a nurturing and engaging environment for children. They wanted a recruitment campaign that would showcase their values and attract top talent to join their team. Our videography Sunshine Coast team were excited to fly down to Sydney and help them achieve this goal.</p>",
      "text_color": "#55575C",
      "typography_typography": "custom",
      "typography_font_family": "Montserrat",
      "typography_font_size": {
       "unit": "px",
       "size": 16
